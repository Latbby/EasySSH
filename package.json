{
  "name": "easyssh",
  "productName": "EasySSH",
  "version": "1.1.0",
  "description": "EasySSH —— 简洁的跨平台 SSH 客户端",
  "main": "./out/main/index.js",
  "author": "zhonghaihua",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "prebuild:unpack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-start-lnk.ps1",
    "build:unpack": "npm run build && electron-builder --dir && node scripts/fix-dist.cjs",
    "prebuild:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-start-lnk.ps1",
    "build:win": "npm run build && electron-builder --win && node scripts/fix-dist.cjs",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "verify:ssh": "node scripts/verify-ssh.cjs",
    "verify:sftp": "node scripts/verify-sftp.cjs",
    "verify:store": "node scripts/verify-store.cjs",
    "verify:migrate": "node scripts/verify-migrate.cjs",
    "verify:hostkey": "node scripts/verify-hostkey.cjs",
    "verify:resume": "node scripts/verify-resume.cjs",
    "verify:perf": "node scripts/verify-perf.cjs",
    "verify": "npm run verify:ssh && npm run verify:store && npm run verify:migrate && npm run verify:sftp && npm run verify:hostkey && npm run verify:resume && npm run verify:perf",
    "verify:e2e": "npm run build && node scripts/e2e-smoke.cjs",
    "ui:shot": "node scripts/ui-shot.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
